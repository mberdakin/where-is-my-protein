<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="Bloque 4 - Senales posicionales (NLS, peptido senal, TMD)" description="Clasificacion de localizacion subcelular usando composicion de aminoacidos + fisicoquimicos + senales derivadas de la secuencia (NLS, peptido senal, TMD alfa-helice). Cargar features_composicion_senales_fisicoquimicos.csv en el widget File (marcar accession y sequence como meta). Comparar contra los Bloques 2 y 3 para ver si agregar informacion posicional explicita rompe el techo.">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="File" position="(60.0, 260.0)" />
